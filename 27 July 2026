class Solution {
  public:
    Node* build(vector<int>& pre, vector<int>& preMirror,
                unordered_map<int, int>& pos,
                int pl, int pr, int ml, int mr) {
        
        if (pl > pr)
            return nullptr;
        
        Node* root = new Node(pre[pl]);
        
        if (pl == pr)
            return root;
        
        int leftRoot = pre[pl + 1];
        int k = pos[leftRoot];
        
        int leftSize = mr - k + 1;
        
        root->left = build(
            pre, preMirror, pos,
            pl + 1,
            pl + leftSize,
            k,
            mr
        );
        
        root->right = build(
            pre, preMirror, pos,
            pl + leftSize + 1,
            pr,
            ml + 1,
            k - 1
        );
        
        return root;
    }

    Node* constructBinaryTree(vector<int> &pre, vector<int> &preMirror) {
        unordered_map<int, int> pos;
        
        for (int i = 0; i < preMirror.size(); i++)
            pos[preMirror[i]] = i;
        
        return build(
            pre, preMirror, pos,
            0, pre.size() - 1,
            0, preMirror.size() - 1
        );
    }
};
