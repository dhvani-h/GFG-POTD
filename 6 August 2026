class Solution {
public:
    int countMinOperations(vector<int>& arr) {
        int inc = 0, dbl = 0;

        for (int x : arr) {
            inc += __builtin_popcount(x);

            int cnt = 0;
            while (x > 0) {
                cnt++;
                x >>= 1;
            }
            dbl = max(dbl, max(0, cnt - 1));
        }

        return inc + dbl;
    }
};
