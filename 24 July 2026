class Solution {
public:
    int ans = 1;

    void dfs(Node* root, int len) {
        if (root == NULL)
            return;

        if (root->left != NULL && root->left->data == root->data + 1)
            dfs(root->left, len + 1);
        else
            dfs(root->left, 1);

        if (root->right != NULL && root->right->data == root->data + 1)
            dfs(root->right, len + 1);
        else
            dfs(root->right, 1);

        ans = max(ans, len);
    }

    int longestConsecutive(Node* root) {
        if (root == NULL)
            return -1;

        dfs(root, 1);

        return ans == 1 ? -1 : ans;
    }
};
